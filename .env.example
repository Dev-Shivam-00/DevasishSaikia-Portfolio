# ─────────────────────────────────────────────────────────────────────────
# TEMPLATE ONLY — never put real credentials in this file.
# It is committed to a public repository. Real values belong in .env.local
# (git-ignored) locally, and in the Vercel dashboard for deployments.
# ─────────────────────────────────────────────────────────────────────────

# ── SMTP (server-side only — never exposed to the browser) ───────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Delivery ────────────────────────────────────────────────────────────
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# ── Site ────────────────────────────────────────────────────────────────
# Baked in at build time: change it and redeploy, editing alone does nothing.
NEXT_PUBLIC_SITE_URL=

# ── Analytics ───────────────────────────────────────────────────────────
# Optional. Defaults to the ID in data/site.ts; set this to point a
# deployment at a different Google Analytics property.
NEXT_PUBLIC_GA_ID=
